// ============================================================
// RégieArt — Schema de Prisma (Sprint 1)
// NOTA: Este schema será revisado con el usuario antes del
// Sprint 2 para hacerlo más robusto y completo.
// ============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USUARIOS ────────────────────────────────────────────────
// El ID primario de autenticación viene de Keycloak (keycloakId).
// El usuario se crea en nuestra DB la primera vez que se autentica
// (patrón "lazy provisioning").

model User {
  id          String   @id @default(cuid())
  keycloakId  String   @unique // Sub del JWT de Keycloak
  email       String   @unique
  displayName String
  firstName   String?
  lastName    String?
  avatarUrl   String?
  bannerUrl   String?
  phone       String?
  bio         String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  memberships OrganizationMember[]
  inviteLinks InviteLink[]
  assets      Asset[]

  @@index([email])
  @@map("users")
}

// ─── ORGANIZACIONES (Bandas / Agencias) ──────────────────────

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique // URL amigable: "los-reyes-del-son"
  description String?
  logoUrl     String?
  website     String?
  phone       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  members     OrganizationMember[]
  inviteLinks InviteLink[]
  assets      Asset[]

  @@index([slug])
  @@map("organizations")
}

// ─── MIEMBROS DE ORGANIZACIÓN ────────────────────────────────
// Tabla intermedia con roles. Un usuario puede pertenecer
// a múltiples organizaciones con roles distintos.

model OrganizationMember {
  id             String     @id @default(cuid())
  userId         String
  organizationId String
  role           MemberRole @default(MEMBER)
  joinedAt       DateTime   @default(now())

  // Relaciones
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId]) // Un usuario, un rol por org
  @@index([organizationId])
  @@map("organization_members")
}

// ─── LINKS DE INVITACIÓN ─────────────────────────────────────
// El líder genera un link único. El músico lo abre y se une.

model InviteLink {
  id             String     @id @default(cuid())
  token          String     @unique @default(cuid())
  organizationId String
  createdById    String
  role           MemberRole @default(MEMBER) // Rol que tendrá quien acepte
  expiresAt      DateTime
  usedAt         DateTime?  // null = pendiente, fecha = usado
  createdAt      DateTime   @default(now())

  // Relaciones
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([token])
  @@map("invite_links")
}

// ─── ASSETS (Archivos en Cloudflare R2) ──────────────────────
// Registro de metadatos de cada archivo subido a R2.
// La key de R2 es la fuente de verdad de la ruta; este modelo
// almacena el contexto semántico para búsqueda, trazabilidad y UX.

model Asset {
  id           String      @id @default(cuid())

  // ── Identidad en R2 ───────────────────────────────────────
  key          String      @unique               // Ruta en R2 (determinista, normalizada)
  assetType    AssetType                         // Tipo semántico del archivo
  contentType  String                            // MIME type verificado (ej. audio/mpeg)
  sizeBytes    BigInt                            // Peso real en bytes (BigInt para videos > 2 GB)
  status       AssetStatus @default(PENDING)     // Ciclo de vida del asset
  etag         String?                           // ETag de R2 (checksum de integridad)

  // ── Metadatos de visualización ────────────────────────────
  displayName  String?                           // Nombre legible: "Afiche Temporada 2026"
  originalName String?                           // Nombre original del archivo en el disco del usuario
  description  String?                           // Descripción libre del contenido
  tags         String[]    @default([])          // Etiquetas para filtrado: ["temporada-2026"]
  language     String?                           // ISO 639-1: "es", "fr", "en" (partituras / docs)

  // ── Metadatos técnicos de media ───────────────────────────
  // Populados opcionalmente en el confirm o por un job de análisis posterior
  durationSeconds Float?                         // Duración en segundos (audio / video)
  width           Int?                           // Ancho en píxeles (imágenes / video)
  height          Int?                           // Alto en píxeles (imágenes / video)
  pageCount       Int?                           // Número de páginas (PDFs / partituras)
  bitrate         Int?                           // Bitrate en kbps (audio / video)

  // ── Multipart upload ─────────────────────────────────────
  // Para archivos > 50 MB subidos con S3 Multipart Upload
  isMultipart   Boolean    @default(false)
  uploadId      String?                          // ID del multipart en curso (S3)
  partCount     Int?                             // Número de partes completadas

  // ── Relaciones de negocio ─────────────────────────────────
  uploadedById  String                           // Usuario que generó la URL (siempre presente)
  orgId         String?                          // Organización propietaria (si aplica)
  songId        String?                          // Referencia a canción del repertorio
  eventId       String?                          // Referencia a evento
  memberId      String?                          // Miembro objetivo (docs legales RRHH)

  // ── Versionado ───────────────────────────────────────────
  version       Int         @default(1)          // Incrementa cada vez que se reemplaza el archivo
  replacesId    String?                          // ID del asset que este reemplaza (historial)

  // ── Expiración y control de acceso ───────────────────────
  isPublic      Boolean     @default(false)      // true = accesible por CDN sin firma
  expiresAt     DateTime?                        // Documentos temporales (contratos por evento)

  // ── Auditoría ────────────────────────────────────────────
  createdAt     DateTime    @default(now())
  confirmedAt   DateTime?                        // Timestamp del confirm-upload exitoso
  deletedAt     DateTime?                        // Soft delete (la key en R2 sigue viva hasta el GC)
  updatedAt     DateTime    @updatedAt

  // ── Relaciones ORM ───────────────────────────────────────
  uploadedBy    User         @relation(fields: [uploadedById], references: [id])
  organization  Organization? @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@index([uploadedById])
  @@index([assetType])
  @@index([status])
  @@index([songId])
  @@index([eventId])
  @@index([createdAt])
  @@index([tags])
  @@map("assets")
}

// ─── ENUMS ───────────────────────────────────────────────────

enum MemberRole {
  OWNER          // Creador de la org. Acceso total.
  ADMIN          // Puede gestionar miembros y eventos.
  MEMBER         // Músico/integrante estándar.
  EXTERNAL_TECH  // Técnico externo. Acceso limitado a eventos asignados.
}

// Estado del ciclo de vida de un archivo en el sistema de storage
enum AssetStatus {
  PENDING     // URL generada, archivo no subido o subida no confirmada aún
  CONFIRMED   // HeadObject OK — el archivo existe en R2 y está listo para usar
  PROCESSING  // Análisis post-confirmación en curso (virus scan, transcripción)
  READY       // Procesamiento completado — listo para servir con todos los metadatos
  ARCHIVED    // Movido a cold storage (Cloudflare R2 Infrequent Access)
  DELETED     // Soft delete — pendiente de limpieza real en R2 por el cron job
}

// Tipo semántico del archivo — determina política de MIME, tamaño y ruta
enum AssetType {
  USER_AVATAR
  USER_BANNER
  ORG_BANNER
  AUDIO_TRACK
  MUSIC_SCORE
  FINANCIAL_RECEIPT
  TECHNICAL_FILE
  REFERENCE_VIDEO
  LEGAL_DOCUMENT
}
