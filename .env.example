# =============================================================================
# RégieArt — Variables de entorno
# Desarrollo local: copia como .env y completa los valores.
# Producción (Railway): configura cada sección en el servicio correspondiente.
# NUNCA subas el .env real con valores reales al repositorio.
# =============================================================================


# ─── DESARROLLO LOCAL ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Frontend origins allowed to call the API (Vite desktop + Expo web/dev client)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:5173,http://localhost:8081

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/regieart?schema=public"

KEYCLOAK_URL=http://localhost:8090
# JWT issuer must match the URL in the token's `iss` claim.
KEYCLOAK_ISSUER=http://localhost:8090
# Optional internal URL used by the API to download Keycloak signing keys.
KEYCLOAK_JWKS_URL=http://localhost:8090
KEYCLOAK_REALM=regieart
KEYCLOAK_CLIENT_ID=regieart-api
# Not read directly by the API code today (kept for reference / future use).
KEYCLOAK_CLIENT_SECRET=change-me-in-production
# Admin credentials for POST /auth/register (uses admin-cli on the master realm,
# not the regieart-api client — the master admin already has rights on all realms).
# Must match the Keycloak container's bootstrap admin (KEYCLOAK_ADMIN_PASSWORD
# in docker-compose.yml, hardcoded to "admin" for local dev)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

REDIS_URL=redis://localhost:6379

# WeatherAPI.com — https://www.weatherapi.com/signup.aspx
# Plan gratuito: 1,000,000 llamadas/mes. Dejar vacío para desactivar el clima.
WEATHER_API_KEY=

# Cloudflare R2 (almacenamiento de archivos) — REQUERIDO, la API no arranca sin esto.
# Pide las credenciales al responsable del proyecto, o crea tu propio bucket R2 gratuito
# en https://dash.cloudflare.com/ → R2 → Create bucket → Manage R2 API Tokens.
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=
# Opcional: URL pública del CDN delante del bucket. Si se deja vacía, la descarga
# de archivos falla, pero el resto de la API funciona igual.
STORAGE_CDN_URL=


# =============================================================================
# PRODUCCIÓN — Variables por servicio Railway
# =============================================================================

# ─── SERVICIO: api ────────────────────────────────────────────────────────────
# NODE_ENV=production
# PORT=3000   (Railway lo inyecta automáticamente)
#
# DATABASE_URL  ← Railway lo inyecta automáticamente al enlazar el plugin Postgres (App)
#
# KEYCLOAK_URL=https://<railway-keycloak-public-url>
# KEYCLOAK_ISSUER=https://<railway-keycloak-public-url>
# KEYCLOAK_JWKS_URL=https://keycloak.railway.internal
# KEYCLOAK_REALM=regieart
# KEYCLOAK_CLIENT_ID=regieart-api
# KEYCLOAK_CLIENT_SECRET=<secreto-seguro>
#
# CORS_ORIGINS=https://<tu-frontend>.up.railway.app


# ─── SERVICIO: keycloak ───────────────────────────────────────────────────────
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=<contraseña-segura>
#
# KC_DB=postgres
# KC_DB_URL=jdbc:postgresql://${{Postgres_Keycloak.PGHOST}}:${{Postgres_Keycloak.PGPORT}}/${{Postgres_Keycloak.PGDATABASE}}
# KC_DB_USERNAME=${{Postgres_Keycloak.PGUSER}}
# KC_DB_PASSWORD=${{Postgres_Keycloak.PGPASSWORD}}
#
# KC_PROXY=edge
# KC_HOSTNAME_STRICT=false
# KC_HTTP_ENABLED=true
# KC_HEALTH_ENABLED=true

STORAGE_ENDPOINT=https://test-account-id.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=test-access-key-id-000000000000000
STORAGE_SECRET_ACCESS_KEY=test-secret-access-key-0000000000000000000000000000000000000000
STORAGE_BUCKET_NAME=regieart-dev