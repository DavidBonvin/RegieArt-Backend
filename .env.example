# =============================================================================
# RégieArt — Variables de entorno
# Desarrollo local: copia como .env y completa los valores.
# Producción (Railway): configura cada sección en el servicio correspondiente.
# NUNCA subas el .env real con valores reales al repositorio.
# =============================================================================


# ─── DESARROLLO LOCAL ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/regieart?schema=public"

KEYCLOAK_URL=http://localhost:8090
KEYCLOAK_REALM=regieart
KEYCLOAK_CLIENT_ID=regieart-api
# Used for JWT validation AND as service account for POST /auth/register
# The regieart-api service account must have the "manage-users" role
# assigned in Keycloak Admin → Clients → regieart-api → Service Account Roles → realm-management → manage-users
KEYCLOAK_CLIENT_SECRET=change-me-in-production
# Admin credentials for POST /auth/register (uses admin-cli on master realm)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-in-production

REDIS_URL=redis://localhost:6379

# WeatherAPI.com — https://www.weatherapi.com/signup.aspx
# Plan gratuito: 1,000,000 llamadas/mes. Dejar vacío para desactivar el clima.
WEATHER_API_KEY=


# =============================================================================
# PRODUCCIÓN — Variables por servicio Railway
# =============================================================================

# ─── SERVICIO: api ────────────────────────────────────────────────────────────
# NODE_ENV=production
# PORT=3000   (Railway lo inyecta automáticamente)
#
# DATABASE_URL  ← Railway lo inyecta automáticamente al enlazar el plugin Postgres (App)
#
# KEYCLOAK_URL=https://<railway-keycloak-public-url>
# KEYCLOAK_REALM=regieart
# KEYCLOAK_CLIENT_ID=regieart-api
# KEYCLOAK_CLIENT_SECRET=<secreto-seguro>
#
# CORS_ORIGINS=https://<tu-frontend>.up.railway.app


# ─── SERVICIO: keycloak ───────────────────────────────────────────────────────
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=<contraseña-segura>
#
# KC_DB=postgres
# KC_DB_URL=jdbc:postgresql://${{Postgres_Keycloak.PGHOST}}:${{Postgres_Keycloak.PGPORT}}/${{Postgres_Keycloak.PGDATABASE}}
# KC_DB_USERNAME=${{Postgres_Keycloak.PGUSER}}
# KC_DB_PASSWORD=${{Postgres_Keycloak.PGPASSWORD}}
#
# KC_PROXY=edge
# KC_HOSTNAME_STRICT=false
# KC_HTTP_ENABLED=true
# KC_HEALTH_ENABLED=true

STORAGE_ENDPOINT=https://test-account-id.r2.cloudflarestorage.com
+ STORAGE_ACCESS_KEY_ID=test-access-key-id-000000000000000
+ STORAGE_SECRET_ACCESS_KEY=test-secret-access-key-0000000000000000000000000000000000000000
+ STORAGE_BUCKET_NAME=regieart-dev