# ============================================================
# RégieArt — Variables de Entorno
# Copia este archivo como .env y completa los valores
# NUNCA subas .env al repositorio
# ============================================================

# App
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Base de Datos (Railway PostgreSQL en producción)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/regieart?schema=public"

# Keycloak (SSO)
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=regieart
KEYCLOAK_CLIENT_ID=regieart-api
KEYCLOAK_CLIENT_SECRET=change-me-in-production

# Redis (Upstash en producción, local en desarrollo)
REDIS_URL=redis://localhost:6379
